{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/second-brain/registry-entry.schema.json",
  "title": "Entrée de registre Second Brain",
  "description": "Schéma d'une entrée atomique (DEC-006). Champs opérationnels et mapping ClickUp (DEC-007) : le local est SoT ; ClickUp est une projection. SQLite reste un index dérivé.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "status",
    "title",
    "created",
    "updated",
    "sources",
    "relations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Identifiant stable, jamais réutilisé.",
      "pattern": "^(FACT|HYP|IDEA|OPEN|DEC|TASK|ISSUE|REF)-[0-9]{3,}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "fact",
        "hypothesis",
        "idea",
        "question",
        "decision",
        "task",
        "issue",
        "reference"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "deferred",
        "active",
        "blocked",
        "resolved",
        "settled",
        "superseded"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target_id"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "supports",
              "contradicts",
              "supersedes",
              "derived_from",
              "implements",
              "related_to",
              "blocks",
              "duplicate_of"
            ]
          },
          "target_id": {
            "type": "string",
            "pattern": "^(FACT|HYP|IDEA|OPEN|DEC|TASK|ISSUE|REF)-[0-9]{3,}$"
          }
        }
      }
    },
    "scope": {
      "type": "string",
      "enum": ["system", "project", "component"]
    },
    "certainty": {
      "type": "string",
      "enum": ["verified", "likely", "unknown"]
    },
    "superseded_by": {
      "type": "string",
      "pattern": "^(FACT|HYP|IDEA|OPEN|DEC|TASK|ISSUE|REF)-[0-9]{3,}$"
    },
    "assignees": {
      "type": "array",
      "description": "Assignés canoniques (local). Projetés vers ClickUp.",
      "items": { "type": "string", "minLength": 1 }
    },
    "due": {
      "type": "string",
      "description": "Échéance ISO date ou datetime (local SoT).",
      "format": "date"
    },
    "priority": {
      "type": "string",
      "enum": ["urgent", "high", "normal", "low"]
    },
    "list": {
      "type": "string",
      "description": "Clé logique de liste ClickUp (ex. Tasks, Issues, Roadmap), résolue via .clickup/mapping.yaml."
    },
    "milestone": {
      "type": "string",
      "description": "Jalon / phase logique (local)."
    },
    "acceptance": {
      "type": "array",
      "description": "Critères d'acceptation, une ligne chacun — pour l'IA et la description ClickUp.",
      "items": { "type": "string", "minLength": 1 }
    },
    "clickup": {
      "type": "object",
      "description": "Mapping projection ClickUp (DEC-007). Ne remplace pas les champs métier locaux.",
      "additionalProperties": false,
      "properties": {
        "task_id": { "type": "string" },
        "list_id": { "type": "string" },
        "last_pushed": {
          "type": "string",
          "description": "Horodatage ou date du dernier push réussi local → ClickUp."
        },
        "url": { "type": "string" }
      }
    }
  }
}
